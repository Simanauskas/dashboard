# Cloudflare Pages cache rules.
#
# The Garmin bot pushes hourly, so every deploy emits a new content-hashed
# bundle and deletes the previous one. A cached index.html therefore ends up
# pointing at an asset that no longer exists -> 404 -> blank page. Keeping the
# HTML entry point revalidated on every request is what prevents that; the
# hashed assets under /assets/ are safe to cache forever because their names
# change whenever their contents do.

/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
